# -----------------------------------------------------------------------------
# ProvenPack — variables de entorno
# Copia este archivo a `.env.local` y completa lo que tengas. Todo es opcional
# en local: sin credenciales la app usa Postgres embebido, correo simulado y
# almacenamiento en disco (ver docs/deploy.md y docs/DECISIONES.md).
# -----------------------------------------------------------------------------

# --- Sitio y marca (públicas: se exponen al navegador) ------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=ProvenPack
NEXT_PUBLIC_BRAND_SLOGAN=Probamos que somos los mejores
# Número de WhatsApp con código de país, solo dígitos (valor de EJEMPLO).
NEXT_PUBLIC_WHATSAPP_NUMBER=50760000000
# Correo de contacto visible en el sitio (valor de EJEMPLO).
NEXT_PUBLIC_CONTACT_EMAIL=hola@provenpack.com

# --- Base de datos ------------------------------------------------------------
# Sin DATABASE_URL se usa Postgres embebido local en el puerto 54322.
# En producción: cadena del pooler de Supabase (modo transacción, puerto 6543).
DATABASE_URL=
# Tamaño del pool por instancia (1 en serverless con pooler de Supabase).
DB_POOL_MAX=5

# --- Supabase (Auth por enlace mágico y Storage privado) ----------------------
# Sin estas tres variables: login por enlace mágico simulado (el enlace se
# imprime en consola) y archivos en disco local (STORAGE_LOCAL_DIR).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_LOCAL_DIR=.data/storage
# Solo si se usa el cliente de navegador de Supabase (no requerido en el MVP).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto para firmar sesiones locales y URLs locales de archivos (≥ 32 caracteres).
AUTH_SECRET=

# Primer usuario con este correo queda como admin.
ADMIN_EMAIL=

# --- Correo transaccional (Resend) --------------------------------------------
# Sin RESEND_API_KEY los correos se escriben en consola y en la tabla
# `notifications` con estado `simulated`.
RESEND_API_KEY=
MAIL_FROM=ProvenPack <no-reply@provenpack.com>
# Correo de la fábrica que recibe los RFQ (valor de EJEMPLO).
FACTORY_EMAIL=

# --- Tareas programadas -------------------------------------------------------
# Vercel Cron envía `Authorization: Bearer $CRON_SECRET` a /api/cron/*.
CRON_SECRET=

# --- Analytics (si faltan, los helpers no hacen nada) -------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Errores (opcional) -------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# --- Captcha invisible Cloudflare Turnstile (opcional) ------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
