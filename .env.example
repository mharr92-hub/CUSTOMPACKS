# =============================================================================
# ProvenPack — variables de entorno
# =============================================================================
# Cómo se usa:
#   - Local: copia este archivo a `.env.local`. Todo es opcional: sin
#     credenciales la app usa Postgres embebido, correo simulado y archivos en
#     disco.
#   - Producción: copia este archivo a `.env.production`, complétalo y revísalo
#     con `pnpm run doctor --env .env.production --produccion`. Después pégalo en
#     Vercel → Settings → Environment Variables → "Import .env" (Production).
#   - Previews: `pnpm supabase:preview --ejecutar` genera `.env.preview`
#     (docs/deploy.md, paso 2).
# Ningún archivo .env* con valores reales va al repositorio (.gitignore).
#
# Cada bloque dice DÓNDE va (Vercel, GitHub o solo local), CÓMO se obtiene y
# QUÉ PASA SIN ELLA. Lo marcado OBLIGATORIA es para producción.
# =============================================================================

# --- Sitio y marca ------------------------------------------------------------
# Dónde: Vercel (Production; en Preview, la URL estable de los previews).
# OBLIGATORIA. URL pública https, sin barra final. Sin ella, los enlaces de
# correos, WhatsApp, PDF y sitemap apuntan a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nombre y lema que muestra el sitio (públicos).
NEXT_PUBLIC_BRAND_NAME=ProvenPack
NEXT_PUBLIC_BRAND_SLOGAN=Probamos que somos los mejores

# --- WhatsApp y contacto (públicas) -------------------------------------------
# Dónde: Vercel (Production y Preview).
# OBLIGATORIA. Número de WhatsApp del negocio con código de país, solo
# dígitos. El valor de abajo es de EJEMPLO: sin cambiarlo, los botones de
# WhatsApp llevan a un número que no es tuyo.
NEXT_PUBLIC_WHATSAPP_NUMBER=50760000000
# Correo visible en el sitio y en la política de privacidad (valor de EJEMPLO).
NEXT_PUBLIC_CONTACT_EMAIL=hola@provenpack.com

# --- Base de datos (Supabase Postgres) ----------------------------------------
# Dónde: Vercel (Production; Preview con el proyecto de previews).
# Cómo: Supabase → Project Settings → Database → Connection string →
#   Transaction pooler (puerto 6543).
# OBLIGATORIA. Sin ella se usa el Postgres embebido local (puerto 54322): solo
# sirve en tu computadora.
DATABASE_URL=
# Conexiones por instancia: 1 en Vercel (el pooler reparte). 5 en local.
DB_POOL_MAX=5

# --- Supabase: ingreso por enlace mágico y archivos ---------------------------
# Dónde: Vercel (Production y Preview, cada uno con su proyecto).
# Cómo: Supabase → Project Settings → API (Project URL, anon public,
#   service_role). La service_role es secreta: solo servidor.
# OBLIGATORIAS las tres. Sin ellas: el enlace de ingreso se imprime en la
# consola y los archivos van a STORAGE_LOCAL_DIR (en Vercel ese disco se borra).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo local: carpeta de archivos cuando no hay Supabase.
STORAGE_LOCAL_DIR=.data/storage
# No hacen falta en el MVP (el navegador no habla con Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sesiones del panel -------------------------------------------------------
# Dónde: Vercel (una distinta en Production y en Preview).
# Cómo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# OBLIGATORIA (32 caracteres o más). Sin ella, en producción el panel no deja
# entrar a nadie.
AUTH_SECRET=
# OBLIGATORIA. Tu correo: recibe el rol admin al confirmarlo y los avisos
# internos mientras no cargues team_notification_email en Configuración.
ADMIN_EMAIL=

# --- Correo transaccional (Resend) --------------------------------------------
# Dónde: Vercel (solo Production; en Preview NO, para que los correos queden
# simulados).
# Cómo: resend.com → API Keys, con el dominio verificado (SPF, DKIM, DMARC).
# OBLIGATORIA para operar. Sin ella los correos se escriben en la consola y en
# la tabla `notifications` con estado `simulated`: ni clientes ni equipo los
# reciben.
RESEND_API_KEY=
# Remitente con el dominio verificado en Resend.
MAIL_FROM=ProvenPack <no-reply@provenpack.com>
# Correo de la fábrica que recibe los RFQ y sus recordatorios. Sin él, el RFQ
# se marca enviado a mano y no hay recordatorio a las 48 horas hábiles.
FACTORY_EMAIL=

# --- Tareas programadas -------------------------------------------------------
# Dónde: Vercel (Production y Preview) y el mismo valor al correr
# `pnpm cron:install` contra Supabase.
# Cómo: igual que AUTH_SECRET, pero distinta (24 caracteres o más).
# OBLIGATORIA. Vercel Cron y Supabase Cron llaman a /api/cron/* con
# `Authorization: Bearer $CRON_SECRET`. Sin ella no corren el SLA, los
# recordatorios, la retención ni la purga de borradores.
CRON_SECRET=

# --- Captcha invisible (Cloudflare Turnstile, gratis) -------------------------
# Dónde: Vercel (Production; en Preview pueden ir las claves de prueba de
# Cloudflare: 1x00000000000000000000AA y 1x0000000000000000000000000000000AA).
# Cómo: dash.cloudflare.com → Turnstile → Add site.
# OBLIGATORIAS las dos en producción. Sin ellas el cotizador queda expuesto a
# envíos automáticos y el panel muestra un aviso rojo permanente.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Medición (opcionales; si faltan, no se carga nada) -----------------------
# Dónde: Vercel (solo Production).
# Google Analytics 4 (G-XXXXXXX): embudo del cotizador.
NEXT_PUBLIC_GA_ID=
# Meta Pixel (solo dígitos): PageView y Lead para las campañas.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Errores (opcional) -------------------------------------------------------
# Dónde: Vercel. Cómo: sentry.io (plan gratuito) → proyecto → Client Keys (DSN).
# Sin ella, los errores solo quedan en los logs de Vercel.
NEXT_PUBLIC_SENTRY_DSN=
# Detalle de los logs del servidor: debug, info (por defecto, warn).
LOG_LEVEL=

# --- Respaldos: NO van en Vercel, van en GitHub -------------------------------
# Dónde: GitHub → Settings → Secrets and variables → Actions (docs/respaldos.md).
# Aquí solo sirven para revisarlas con `pnpm run doctor`.
# Base (secretos): conexión directa o Session pooler (5432) y la clave con que
# se cifran los respaldos (guárdala también fuera de GitHub).
# BACKUP_DATABASE_URL=
# BACKUP_PASSPHRASE=
# Variable (no secreta) de GitHub: esquemas a respaldar.
# BACKUP_SCHEMAS=public
# Copia diaria de archivos a un almacenamiento compatible con S3 (secretos).
# Origen: Supabase → Storage → Settings → S3 Connection.
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# Destino: el almacenamiento que elijas (docs/respaldos.md, sección 5).
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Variable (no secreta) de GitHub: bucket de destino.
# BACKUP_S3_BUCKET=

# --- Proyecto de Supabase para los previews (solo local, una vez) -------------
# Las usa `pnpm supabase:preview --ejecutar` (docs/deploy.md, paso 2).
# Token personal: supabase.com → Account → Access Tokens.
# SUPABASE_ACCESS_TOKEN=
# Organización (slug), si tienes más de una. Debe estar en el plan Free.
# SUPABASE_ORG=
# URL estable de los previews en Vercel.
# PREVIEW_SITE_URL=https://custompacks-git-main-<equipo>.vercel.app
# Para reutilizar un proyecto ya creado:
# SUPABASE_PREVIEW_REF=
# SUPABASE_PREVIEW_DB_PASSWORD=

# --- Solo local ----------------------------------------------------------------
# Puerto y carpeta del Postgres embebido; LOCAL_DB_RESET=1 lo recrea al arrancar.
# LOCAL_DB_PORT=54322
# LOCAL_DB_DIR=.data/postgres
# LOCAL_DB_RESET=

# --- Solo para pruebas (NUNCA en producción: con VERCEL_ENV=production el ------
# --- servidor no arranca si están definidas) ----------------------------------
# Muestra el enlace de acceso en pantalla en un build de producción local.
ALLOW_LOCAL_AUTH_LINKS=
# Multiplica los límites de intentos (la suite e2e corre todo desde una IP).
RATE_LIMIT_FACTOR=
# Habilita /prueba-error para probar la pantalla de error (e2e). No impide
# arrancar, pero no debe estar en producción.
# ENABLE_ERROR_TEST_ROUTE=
