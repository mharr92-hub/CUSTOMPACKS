# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# datos locales (Postgres embebido, archivos subidos, correos simulados)
/.data/

# playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# supabase cli
/supabase/.temp/
/supabase/.branches/

# herramientas locales
/scripts/_*.mjs
